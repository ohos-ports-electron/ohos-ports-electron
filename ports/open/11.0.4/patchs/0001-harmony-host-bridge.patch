+
+const invalid = message => Object.assign(new TypeError(message), {code: 'ERR_OPEN_HARMONY_INVALID_OPTION'});
+
+function validateValue(value, ancestors = new Set(), depth = 0) {
+	if (['string', 'boolean'].includes(typeof value) || (typeof value === 'number' && Number.isFinite(value) && !Object.is(value, -0))) {
+		return;
+	}
+
+	if (value === null || typeof value !== 'object' || depth > 16 || ancestors.has(value)) {
+		throw invalid('HarmonyOS parameters require finite, acyclic Want values without null or negative zero (maximum depth 16).');
+	}
+
+	if (!Array.isArray(value) && ![Object.prototype, null].includes(Object.getPrototypeOf(value))) {
+		throw invalid('HarmonyOS parameters must use plain JSON objects and arrays.');
+	}
+
+	if (Object.getOwnPropertySymbols(value).length > 0) {
+		throw invalid('HarmonyOS parameters cannot contain symbol keys.');
+	}
+
+	ancestors.add(value);
+	if (Array.isArray(value)) {
+		const elementType = typeof value[0];
+		if (value.length === 0 || !['string', 'number', 'boolean'].includes(elementType)
+			|| value.some(item => typeof item !== elementType) || Object.keys(value).length !== value.length) {
+			throw invalid('Want arrays must be nonempty, homogeneous strings, numbers or booleans; other arrays may lose data in AbilityKit.');
+		}
+
+		for (let index = 0; index < value.length; index++) {
+			if (!Object.hasOwn(value, index)) {
+				throw invalid('HarmonyOS parameter arrays cannot contain holes.');
+			}
+		}
+	}
+
+	for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(value))) {
+		if (descriptor.get || descriptor.set || (!descriptor.enumerable && !(Array.isArray(value) && key === 'length'))) {
+			throw invalid('HarmonyOS parameters cannot contain accessors or non-enumerable values.');
+		}
+
+		validateValue(descriptor.value, ancestors, depth + 1);
+	}
+
+	ancestors.delete(value);
+}
+
+export function abilityOptions(options, app, appArguments) {
+	if (options.harmony === undefined) {
+		return;
+	}
