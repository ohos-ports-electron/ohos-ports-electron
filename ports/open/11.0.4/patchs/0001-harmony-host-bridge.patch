+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawnSync} from 'node:child_process';
+import {parseArgs} from 'node:util';
+
+const {values} = parseArgs({options: {ndk: {type: 'string'}, out: {type: 'string'}, 'code-sign': {type: 'boolean', default: false}}});
+if (!values.ndk || !values.out) {
+	throw new Error('Usage: node build-launcher.mjs --ndk ABSOLUTE_OHOS_NDK --out OUTPUT_ELF');
+}
+
+const compiler = path.join(values.ndk, 'llvm/bin/aarch64-unknown-linux-ohos-clang');
+const source = fileURLToPath(new URL('open-launcher.c', import.meta.url));
+fs.mkdirSync(path.dirname(path.resolve(values.out)), {recursive: true});
+const arguments_ = [
+	'-std=c11',
+	'-Wall',
+	'-Wextra',
+	'-Werror',
+	'-O2',
+	'-fPIE',
+	'-pie',
+	...(values['code-sign'] ? ['-Wl,--code-sign'] : []),
+	source,
+	'-o',
+	path.resolve(values.out),
+];
+const result = spawnSync(compiler, arguments_, {stdio: 'inherit'});
+if (result.error) {
+	throw result.error;
+}
+
+if (result.status !== 0) {
+	throw new Error(`OHOS launcher compiler exited with code ${result.status}, signal ${result.signal}.`);
+}
+
+fs.chmodSync(values.out, 0o755);
