+/* MIT. Private HNP launcher: submit one host request and relay its response.
+ * This process launches a Want through its owning HAP; it is not the target app.
+ * Build with the OHOS NDK and package as private HNP, never writable app data.
+ */
+#define _POSIX_C_SOURCE 200809L
+#define _DARWIN_C_SOURCE 1
+#define _GNU_SOURCE 1
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static long long millis(void) {
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) return -1;
+    return (long long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
+}
+
+static int write_all(int fd, const char *data, size_t size) {
+    while (size) {
+        ssize_t n = write(fd, data, size);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -1;
+        data += n;
+        size -= (size_t)n;
+    }
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc != 4 || strcmp(argv[1], "--bridge-v1") != 0 || argv[2][0] != '/' ||
+        strlen(argv[3]) != 36 || strspn(argv[3], "0123456789abcdef-") != 36) {
+        fputs("Usage: open-launcher --bridge-v1 ABSOLUTE_PRIVATE_DIRECTORY UUID\n", stderr);
+        return 64;
+    }
+    char pending[4096], input[4096], output[4096], response[65536];
+    if (snprintf(pending, sizeof pending, "%s/%s.tmp", argv[2], argv[3]) >= (int)sizeof pending ||
+        snprintf(input, sizeof input, "%s/%s.request.json", argv[2], argv[3]) >= (int)sizeof input ||
+        snprintf(output, sizeof output, "%s/%s.response.json", argv[2], argv[3]) >= (int)sizeof output) {
+        fputs("Bridge path too long\n", stderr);
+        return 64;
+    }
+    if (rename(pending, input) != 0) { perror("submit open request"); return 74; }
+    long long deadline = millis() + 14000;
+    for (;;) {
+        int fd = open(output, O_RDONLY | O_NOFOLLOW);
+        if (fd >= 0) {
+            size_t length = 0;
+            while (length < sizeof response) {
+                ssize_t n = read(fd, response + length, sizeof response - length);
+                if (n < 0 && errno == EINTR) continue;
+                if (n < 0) { perror("read host response"); close(fd); return 74; }
+                if (n == 0) break;
+                length += (size_t)n;
+            }
+            close(fd);
+            if (!length || length == sizeof response) { fputs("Invalid host response size\n", stderr); return 74; }
+            if (write_all(STDOUT_FILENO, response, length) || write_all(STDOUT_FILENO, "\n", 1)) return 74;
+            /* Parent acknowledges only after handing the ChildProcess to its caller.
+             * EOF also releases us when the parent exits immediately after await. */
+            struct pollfd ack = { .fd = STDIN_FILENO, .events = POLLIN | POLLHUP };
+            int ready;
+            do { ready = poll(&ack, 1, 5000); } while (ready < 0 && errno == EINTR);
+            char byte;
+            if (ready > 0) (void)read(STDIN_FILENO, &byte, 1);
+            return 0;
+        }
+        if (errno != ENOENT) { perror("open host response"); return 74; }
+        if (millis() >= deadline) { fputs("Host response timed out\n", stderr); return 124; }
+        struct timespec interval = { .tv_sec = 0, .tv_nsec = 20000000 };
+        nanosleep(&interval, NULL);
+    }
+}
