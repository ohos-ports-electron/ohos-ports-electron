+	if (config.waitForResult !== undefined && typeof config.waitForResult !== 'boolean') {
+		throw invalid('harmony.waitForResult must be a boolean.');
+	}
+
+	const waitForResult = config.waitForResult === true;
+	if (config.onResult !== undefined && (typeof config.onResult !== 'function' || !waitForResult)) {
+		throw invalid('harmony.onResult requires waitForResult: true and must be a function.');
+	}
