+import { fileIo as fs, fileUri } from '@kit.CoreFileKit';
+import { BusinessError } from '@kit.BasicServicesKit';
+
+class OpenRequest {
+  version: number = 0;
+  id: string = '';
+  kind: string = '';
+  target: string = '';
+  application: string = '';
+  expiresAt: number = 0;
+  parameters?: Record<string, Object>;
+  waitForResult: boolean = false;
+  resultDeadline: number = 0;
+}
+
+class OpenResponse {
+  version: number = 1;
+  id: string = '';
+  ok: boolean = false;
+  phase: string = 'completed';
+  code: string = '';
+  message: string = '';
+  result?: common.AbilityResult;
+}
+
+class ResultJob {
+  deadline: number;
+  canceled: boolean = false;
+  constructor(deadline: number) { this.deadline = deadline; }
+}
+
+class OpenBridgeError extends Error {
+  code: string;
+  constructor(code: string, message: string) {
+    super(message);
+    this.code = code;
+  }
+}
+
+// Protocol 1 remains available. Protocol 2 acknowledges cooperative requests,
+// then publishes their real AbilityResult without blocking other requests.
+export class OpenHostBridge {
+  private context: common.UIAbilityContext;
+  private directory: string;
+  private timer: number = -1;
+  private busy: boolean = false;
+  private jobs: Map<string, ResultJob> = new Map<string, ResultJob>();
+
+  constructor(context: common.UIAbilityContext) {
+    this.context = context;
+    this.directory = context.getApplicationContext().filesDir + '/open-harmony-bridge';
+  }
+
+  start(): void {
+    try { fs.mkdirSync(this.directory, true); }
+    catch (error) {
+      if (!fs.accessSync(this.directory)) { throw new Error((error as BusinessError).message); }
+    }
+    console.info('OPENHOST ready protocol=1,2 directory=' + this.directory);
+    this.timer = setInterval(() => { this.poll(); }, 50);
+  }
+
+  stop(): void {
+    if (this.timer >= 0) { clearInterval(this.timer); this.timer = -1; }
+    this.jobs.clear();
+  }
+
+  private respond(response: OpenResponse, suffix: string): void {
+    const output = this.directory + '/' + response.id + suffix;
+    const file = fs.openSync(output + '.tmp', fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
+    try { fs.writeSync(file.fd, JSON.stringify(response)); }
+    finally { fs.closeSync(file); }
+    fs.renameSync(output + '.tmp', output);
+  }
+
+  private setError(response: OpenResponse, error: Error): void {
+    response.ok = false;
+    response.message = error.message;
+    if (error instanceof OpenBridgeError) { response.code = error.code; }
+    else { response.code = String((error as BusinessError).code || 'ERR_OPEN_HARMONY_OPEN_FAILED'); }
+  }
+
+  private mime(path: string): string {
+    if (path.endsWith('.png')) { return 'image/png'; }
+    if (path.endsWith('.jpg') || path.endsWith('.jpeg')) { return 'image/jpeg'; }
+    if (path.endsWith('.pdf')) { return 'application/pdf'; }
+    if (path.endsWith('.html')) { return 'text/html'; }
+    if (path.endsWith('.txt')) { return 'text/plain'; }
+    return '*/*';
+  }
+
+  private complete(id: string, result: common.AbilityResult | undefined, error: Error | undefined): void {
+    const job = this.jobs.get(id);
+    if (!job) { return; }
+    this.jobs.delete(id);
+    // Abandon client waiting, never terminate the target application. Suppress
+    // late responses so timed-out calls do not leave orphan result files.
+    if (job.canceled || job.deadline <= Date.now()) {
+      console.info('OPENHOST abandoned result id=' + id);
+      return;
+    }
+    const response = new OpenResponse();
+    response.version = 2;
+    response.id = id;
+    if (error) { this.setError(response, error); }
+    else { response.ok = true; response.result = result; }
+    try {
+      this.respond(response, '.completion.json');
+      console.info('OPENHOST completed id=' + id + ' ok=' + response.ok);
+    } catch (writeError) {
+      console.error('OPENHOST completion write failed id=' + id + ' error=' + JSON.stringify(writeError));
+    }
+  }
+
+  private async dispatch(request: OpenRequest): Promise<string> {
+    if ((request.version !== 1 && request.version !== 2) || request.expiresAt < Date.now()) {
+      throw new OpenBridgeError('ERR_OPEN_HARMONY_PROTOCOL', 'Invalid or expired open request');
+    }
+    if (request.version === 1 && (request.parameters || request.waitForResult)) {
+      throw new OpenBridgeError('ERR_OPEN_HARMONY_PROTOCOL', 'Ability extensions require protocol 2');
+    }
+    const want: Want = {};
+    if (request.application) {
+      const parts = request.application.split('/');
+      if (!new RegExp('^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)+$').test(parts[0]) || parts.length > 2) {
+        throw new Error('Use a HarmonyOS bundle name, optionally followed by /AbilityName');
+      }
+      want.bundleName = parts[0];
+      if (parts.length === 2) { want.abilityName = parts[1]; }
+    }
+    if (request.parameters) { want.parameters = request.parameters; }
+    if (request.kind === 'app') {
+      if (!request.application) { throw new Error('Missing application bundle'); }
+      want.action = 'action.system.home';
+      want.entities = ['entity.system.home'];
+    } else if (request.kind === 'url') {
+      want.action = 'ohos.want.action.viewData';
+      want.uri = request.target;
+      if (request.target.startsWith('http:') || request.target.startsWith('https:')) {
+        want.entities = ['entity.system.browsable'];
+      }
+    } else if (request.kind === 'file') {
+      if (!request.target.startsWith('/') || !fs.accessSync(request.target)) { throw new Error('File does not exist'); }
+      want.action = 'ohos.want.action.viewData';
+      want.uri = fileUri.getUriFromPath(request.target);
+      want.type = this.mime(request.target);
+      want.flags = wantConstant.Flags.FLAG_AUTH_READ_URI_PERMISSION;
+    } else { throw new Error('Unsupported request kind'); }
+    console.info('OPENHOST dispatch id=' + request.id + ' waitForResult=' + request.waitForResult);
+    if (request.waitForResult) {
+      if (!request.application || request.resultDeadline <= Date.now() || request.resultDeadline > Date.now() + 86400000) {
+        throw new OpenBridgeError('ERR_OPEN_HARMONY_INVALID_OPTION', 'Invalid result deadline or target');
+      }
+      // Keep canceled-but-unresolved registrations until the SDK callback, so
+      // repeated timeouts cannot allocate unbounded native result callbacks.
+      if (this.jobs.size >= 16) {
+        throw new OpenBridgeError('ERR_OPEN_HARMONY_BUSY', 'Too many unresolved Ability result requests');
+      }
+      const operation = this.context.startAbilityForResult(want);
+      this.jobs.set(request.id, new ResultJob(request.resultDeadline));
+      operation.then((result: common.AbilityResult) => {
+        this.complete(request.id, result, undefined);
+      }).catch((error: BusinessError) => {
+        this.complete(request.id, undefined, error);
+      });
+      return 'accepted';
+    }
+    await this.context.startAbility(want);
+    return 'completed';
+  }
+
+  private async poll(): Promise<void> {
+    if (this.busy) { return; }
+    this.busy = true;
+    try {
+      this.jobs.forEach((job: ResultJob) => {
+        if (job.deadline <= Date.now()) { job.canceled = true; }
+      });
+      const names = fs.listFileSync(this.directory);
+      for (const name of names) {
+        if (new RegExp('^[0-9a-f-]{36}\\.cancel$').test(name)) {
+          const job = this.jobs.get(name.substring(0, 36));
+          if (job) { job.canceled = true; }
+          fs.unlinkSync(this.directory + '/' + name);
+          continue;
+        }
+        if (!new RegExp('^[0-9a-f-]{36}\\.request\\.json$').test(name)) { continue; }
+        const input = this.directory + '/' + name;
+        const response = new OpenResponse();
+        response.id = name.substring(0, 36);
+        try {
+          const request = JSON.parse(fs.readTextSync(input)) as OpenRequest;
+          response.version = request.version === 2 ? 2 : 1;
+          if (request.id !== response.id) { throw new Error('Request ID mismatch'); }
+          fs.unlinkSync(input);
+          response.phase = await this.dispatch(request);
+          response.ok = true;
+        } catch (error) {
+          this.setError(response, error as Error);
+          console.error('OPENHOST failed id=' + response.id + ' error=' + JSON.stringify(error));
+        }
+        this.respond(response, '.response.json');
+      }
+    } catch (error) {
+      console.error('OPENHOST poll error=' + JSON.stringify(error));
+    } finally { this.busy = false; }
+  }
+}
