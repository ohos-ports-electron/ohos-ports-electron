{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:entry_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "2in1",
      "tablet",
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "extractNativeLibs": true,
    // 私有 HNP 声明——本模板的要害。二进制随 HAP 装到 /data/app/<bundle>.org/<name>_<ver>/bin/，
    // 标签 private_hnp_file:s0，app 域原生模块可直接 exec；同时在 /data/app/bin/<tool> 生成符号链接。
    // 包文件本身由 build/build-hap.sh 打包并 zip 注入（hvigor 不会自动收 .hnp）。
    "hnpPackages": [
      {
        "package": "ohportsdeviceidnode.hnp",
        "type": "private"
      }
    ],
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "metadata": [
      {
        "name": "ArkTSPartialUpdate",
        "value": "true"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ]
  }
}
